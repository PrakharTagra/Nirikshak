# ==============================================================================
# LM-VERIFY — MongoDB Atlas Configuration
# ==============================================================================
# Paste your MongoDB Atlas connection string below.
# Format: mongodb+srv://<username>:<password>@<cluster-url>/<dbname>?retryWrites=true&w=majority
# Make sure your IP is whitelisted in Atlas Network Access.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/lm_verify?retryWrites=true&w=majority

# Authentication & Security
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
INSPECTOR_TOKEN_TTL=7d

# Service Ports & Origins
ADMIN_BACKEND_PORT=4001
SENIOR_INSPECTOR_BACKEND_PORT=4002
ADMIN_FRONTEND_ORIGIN=http://localhost:5171
SENIOR_INSPECTOR_FRONTEND_ORIGIN=http://localhost:5172

# Optional Seed Defaults
SEED_CLM_USERNAME=clm.admin
SEED_CLM_PASSWORD=Admin@12345
DEMO_OFFICER_PASSWORD=Demo@12345

