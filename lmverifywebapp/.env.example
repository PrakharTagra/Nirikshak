# ==============================================================================
# LM-Verify Production Environment Configuration (.env)
# ==============================================================================

# MongoDB Atlas Connection
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/lm_verify?retryWrites=true&w=majority

# Authentication & Security
# Generate a strong 32+ char secret in bash: openssl rand -base64 32
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key
JWT_EXPIRES_IN=8h
INSPECTOR_TOKEN_TTL=7d

# Backend Service Ports on EC2
ADMIN_BACKEND_PORT=4001
SENIOR_INSPECTOR_BACKEND_PORT=4002

# Allowed Frontend Origins for CORS
# Set these to your deployed Vercel domain(s) without trailing slashes.
# Comma-separated values are supported.
# Example: https://lmverify-admin.vercel.app,https://lmverify-ac.vercel.app
ADMIN_FRONTEND_ORIGIN=https://<your-admin-app>.vercel.app
SENIOR_INSPECTOR_FRONTEND_ORIGIN=https://<your-inspector-app>.vercel.app

# Optional: Additional CORS Origins (comma-separated, or '*' for unrestricted)
# CORS_ORIGIN=http://localhost:5171,http://localhost:5172
