    "crawlee": "^3.17.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "groq-sdk": "^0.9.1",
    "mongoose": "^9.9.5",
    "playwright": "^1.61.0",
    "sharp": "file:./stubs/sharp"
