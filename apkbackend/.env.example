# ========================================================
# Nirikshak Backend Environment Variables
# Copy this file to .env on your server: cp .env.example .env
# ========================================================

# Server Port (default: 5000)
PORT=5000

# Environment Mode (production / development)
NODE_ENV=production

# MongoDB Atlas Connection URI
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/nirikshak?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/nirikshak?retryWrites=true&w=majority

# DNS Override (Optional)
# Set to 'true' if running behind local Windows/VPN with SRV query issues.
# On AWS EC2 Linux, leave as 'false' to use the default AWS VPC DNS resolver.
DNS_OVERRIDE=false

# Keep-Alive Self-Pinger (Optional - Render automatically populates RENDER_EXTERNAL_URL)
# If hosted on Render, leave empty or set to your Render URL: e.g. https://nirikshak-apk-backend.onrender.com
# KEEP_ALIVE_URL=https://nirikshak-apk-backend.onrender.com
# KEEP_ALIVE_INTERVAL_MINUTES=12
