# ==============================================================================
# Nirikshak ComplianceEngine — Production Environment Configuration
# ==============================================================================

# Server Port
PORT=3000

# Preprocessor / OCR Microservice URL
# (Use http://preprocessor:8000 within Docker Compose, or http://127.0.0.1:8000 for local runs)
PREPROCESSOR_URL=http://preprocessor:8000
PREPROCESSOR_TIMEOUT_MS=180000

# Groq LLM Statutory Extraction
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
GROQ_FALLBACK_TO_REGEX=true

# MongoDB Atlas Connection URI
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/nirikshak?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/compliance_db?retryWrites=true&w=majority

# Cloudinary Cloud Storage Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# PDF Report & Authority Branding
REPORT_ORG_NAME="Legal Metrology Enforcement Authority"
