# Copy to .env and adjust as needed. All are optional — sensible
# defaults are baked into src/config/index.js.

# Where to read input images from / write reports to / stage temp files
INPUT_DIR=./input
OUTPUT_DIR=./output
TEMP_DIR=./temp

# Which provider implementation each stage should use.
# detection: mock | yolo
# ocr:       mock | tesseract | vision
DETECTION_PROVIDER=mock
OCR_PROVIDER=mock

# Cosmetic — appears on the generated PDF report header
REPORT_ORG_NAME=Legal Metrology Enforcement
